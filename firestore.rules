rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inspection_requests/{docId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.createdAt >= '2026-10-26T00:26:00.000Z';
    }
    match /inspection_reports/{docId} {
      allow read, write: if true;
    }
    match /construction_daily_logs/{docId} {
      allow read, write: if true;
    }
    match /completion_reports/{docId} {
      allow read, write: if true;
    }
    match /system_notifications/{docId} {
      allow read, write: if true;
    }
    match /system_users/{docId} {
      allow read, write: if true;
    }
    match /system_buildings/{docId} {
      allow read, write: if true;
    }
    match /system_standards/{docId} {
      allow read, write: if true;
    }
  }
}
